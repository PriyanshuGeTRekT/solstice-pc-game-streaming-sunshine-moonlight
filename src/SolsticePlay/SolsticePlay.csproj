<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Solstice</RootNamespace>
    <AssemblyName>SolsticePlay</AssemblyName>
    <Version>1.0.2</Version>
    <Product>Solstice Play</Product>
    <Description>One-tap game streaming from your PC to this device, built on Moonlight</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- WebView2 ships a WPF assembly this WinForms app never loads; its WindowsBase mismatch is harmless. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- One self-contained file: it is copied to the handheld on its own, with no installer. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
